<?xml version="1.0" encoding="utf-8"?>
<!-- The card itself is a PNG drawn by Flutter (lib/services/home_widgets.dart),
     so it matches the in-app QR exactly. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/qr_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="UPI QR code to pay you"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <TextView
        android:id="@+id/qr_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:padding="16dp"
        android:text="Add your UPI ID in Yumeko › Profile to show your QR here"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</FrameLayout>
